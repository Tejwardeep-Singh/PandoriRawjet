<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/ico/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/ico/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/ico/favicon-32x32.png">
    <link rel="manifest" href="/images/ico/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&family=Fjalla+One&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet"/>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <title>EduSync | HOME</title>
</head>
<body>
    <main>
        <nav>
            <div class="nl">
                <img src="/images/images/LOGO.png" alt="">
            </div>
            <div class="nr">
                <div class="nr-l">
                    <a href="/">Home</a>
                    <div id="login">
                        <a href="#" id="log_button">Login</a>
                        <div id="login_items">
                            <a href="/studentlogin">Student Login</a>
                            <a href="/teacherlogin">Teacher Login</a>
                            <a href="/headlogin">Head Login</a>
                        </div>
                    </div>
                    
                    <a href="/images">Images</a>
                </div>
                <div class="nr-r">
                    <i class="ri-menu-line"></i>
                </div>
            </div>
        </nav>  
        <section id="hero">
            <video autoplay muted loop playsinline>
                <source src="/videos/index_video.mp4" type="video/mp4">
            </video>

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <p class="hero-subtitle">
                    Welcome to
                </p>

                <h1>
                    EDUSYNC SCHOOL
                </h1>

                <h3>
                    Learning Today. Leading Tomorrow.
                </h3>

                <p class="hero-text">

                    Providing quality education through
                    innovation, discipline and holistic
                    student development.

                </p>

                <div class="hero-buttons">

                    <a href="#page2" class="hero-btn">

                        Explore Campus

                    </a>

                    <a href="#login-page" class="hero-btn outline">

                        Login Portal

                    </a>

                </div>

            </div>

        </section>
        <section id="login-section">

                <div class="section-heading">

                    <p>Secure Access</p>

                    <h2>Choose Your Portal</h2>

                </div>

                <div class="portal-container">

                    <a href="/headlogin" class="portal-card">

                        <div class="portal-icon">

                            <i class="ri-admin-fill"></i>

                        </div>

                        <h3>Head Portal</h3>

                        <p>

                            Manage school operations,
                            teachers and students.

                        </p>

                    </a>

                    <a href="/teacherlogin" class="portal-card">

                        <div class="portal-icon">

                            <i class="ri-user-settings-fill"></i>

                        </div>

                        <h3>Teacher Portal</h3>

                        <p>

                            Attendance, marks,
                            timetable and classroom.

                        </p>

                    </a>

                    <a href="/studentlogin" class="portal-card">

                        <div class="portal-icon">

                            <i class="ri-graduation-cap-fill"></i>

                        </div>

                        <h3>Student Portal</h3>

                        <p>

                            View attendance,
                            results and datesheets.

                        </p>

                    </a>

                </div>

        </section>
        <section id="about">

            <div class="about-image">

                <img src="/images/images/school.png">

            </div>

            <div class="about-content">

                <span>ABOUT EDUSYNC</span>

                <h2>

                    Shaping Tomorrow's Leaders

                </h2>

                <p>

                    EduSync School provides a modern
                    learning environment where academic
                    excellence, innovation and character
                    development go hand in hand.

                </p>

                <div class="about-features">

                    <div>

                        <i class="ri-check-line"></i>

                        Smart Classrooms

                    </div>

                    <div>

                        <i class="ri-check-line"></i>

                        Experienced Faculty

                    </div>

                    <div>

                        <i class="ri-check-line"></i>

                        Sports & Activities

                    </div>

                    <div>

                        <i class="ri-check-line"></i>

                        Digital Learning

                    </div>

                </div>

            </div>

        </section>
        <section id="principal">

            <div class="principal-image">

                <img src="/images/images/dummy-head1.png" alt="Principal">

            </div>

            <div class="principal-content">

                <span>Principal's Message</span>

                <h2>

                    Inspiring Every Student
                    To Achieve Excellence

                </h2>

                <p>

                    At EduSync School, we believe that education
                    extends far beyond textbooks. Our mission is to
                    nurture curiosity, discipline, creativity and
                    leadership so every learner becomes confident
                    enough to face tomorrow's challenges.

                </p>

                <h4>

                    — School Principal

                </h4>

            </div>

        </section>
        <section id="stats">

            <div class="stat">

                <h2 class="counter" data-target="1200">0</h2>

                <p>Students</p>

            </div>

            <div class="stat">

                <h2 class="counter" data-target="85">0</h2>

                <p>Teachers</p>

            </div>

            <div class="stat">

                <h2 class="counter" data-target="30">0</h2>

                <p>Classrooms</p>

            </div>

            <div class="stat">

                <h2 class="counter" data-target="98">0</h2>

                <p>Success Rate</p>

            </div>

        </section>
        <section id="facilities">

            <div class="section-heading">

            <p>Campus</p>

            <h2>Our Facilities</h2>

            </div>

            <div class="facility-grid">

            <div class="facility-card">

            <i class="ri-book-open-line"></i>

            <h3>Library</h3>

            <p>

            Thousands of books and digital resources.

            </p>

            </div>

            <div class="facility-card">

            <i class="ri-computer-line"></i>

            <h3>Computer Lab</h3>

            <p>

            Modern systems with latest software.

            </p>

            </div>

            <div class="facility-card">

            <i class="ri-flask-line"></i>

            <h3>Science Lab</h3>

            <p>

            Hands-on experiments and research.

            </p>

            </div>

            <div class="facility-card">

            <i class="ri-basketball-line"></i>

            <h3>Sports</h3>

            <p>

            Indoor and outdoor sports facilities.

            </p>

            </div>

            <div class="facility-card">

            <i class="ri-bus-line"></i>

            <h3>Transport</h3>

            <p>

            Safe transportation throughout the city.

            </p>

            </div>

            <div class="facility-card">

            <i class="ri-building-4-line"></i>

            <h3>Auditorium</h3>

            <p>

            Events, seminars and annual functions.

            </p>

            </div>

            </div>

        </section>
        <section id="gallery-preview">

            <div class="section-heading">

                <p>Campus Life</p>

                <h2>Moments at EduSync</h2>

            </div>

            <div class="gallery-grid">

                <img src="/images/images/sofa.png" alt="sofa">

                <img src="/images/images/museum1.png" alt="museum">

                <img src="/images/images/glass.png" alt="glass">

                <img src="/images/images/stadium_new.png" alt="stadium">

                <img src="/images/images/chess3.0.png" alt="chess">

                <img src="/images/images/olympicStadium.png" alt="olympic">

            </div>

            <a href="/images" class="gallery-btn">

                Explore Full Gallery

                <i class="ri-arrow-right-line"></i>

            </a>

        </section>
        <section id="campus-video">

        <div class="video-content">

        <p>Virtual Tour</p>

        <h2>

        Experience Our Campus

        </h2>

        <p>

        Take a quick look at our classrooms,

        events, laboratories and vibrant student life.

        </p>

        </div>

        <div class="video-grid">

        <video controls poster="/images/images/p1.jpg">

        <source src="/images/videos/V1.mp4">

        </video>

        <video controls poster="/images/images/p2.jpg">

        <source src="/images/videos/V2.mkv">

        </video>

        </div>

        </section>
